# Copie para .env (ou cadastre no painel do host). Nunca versione o .env real.

# --- Rede -------------------------------------------------------------------
# Nº de proxies reversos confiáveis na frente do servidor.
#   0 = servidor exposto direto (X-Forwarded-For é ignorado)  <- padrão local
#   1 = Render / Railway / Fly / Nginx simples (o Render já é detectado sozinho)
# Errar para MENOS: todos os jogadores parecem ter o mesmo IP.
# Errar para MAIS: alguém consegue forjar o IP e burlar bloqueios.
TRUST_PROXY=0

# Origem(ns) do frontend SE ele ficar em domínio separado do backend.
# Vazio em produção = só mesma origem (recomendado quando o server serve o site).
# CORS_ORIGIN=https://meuapp.com,https://www.meuapp.com

# --- Admin / persistência ---------------------------------------------------
# Obrigatório para limpar placar e baixar backup por /admin/backup.
ADMIN_CLEAR_CODE=troque-por-uma-senha-forte
# Disco persistente (Render Disk / volume Docker). Sem isso: ~/.quizarena
# DATA_DIR=/data

# Backup remoto no GitHub (repositório PRIVADO) — ver README.
# GITHUB_BACKUP_REPO=usuario/quizarena-backup
# GITHUB_BACKUP_TOKEN=
